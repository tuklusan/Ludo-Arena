<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:LudoNimArena.Browser"
             xmlns:app="using:LudoNimArena.App"
             x:Class="LudoNimArena.Browser.WebView"
             Background="{StaticResource SystemControlBackgroundBaseLowBrush}">

    <!-- Responsive web layout. Same game and look as the desktop window, reflowed by width
         (see WebView.axaml.cs): Full >= 900, Medium 600-899, Compact < 600 (phones). -->
    <UserControl.Styles>
        <Style Selector="Border.setup">
            <Setter Property="Margin" Value="40"/>
            <Setter Property="Padding" Value="32"/>
        </Style>
        <Style Selector="local|WebView.compact Border.setup">
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Padding" Value="14"/>
        </Style>
        <Style Selector="local|WebView.compact TextBlock.hint"><Setter Property="IsVisible" Value="False"/></Style>
        <Style Selector="local|WebView.compact TextBlock.subtitle"><Setter Property="IsVisible" Value="False"/></Style>
        <Style Selector="local|WebView.compact TextBlock.phase"><Setter Property="IsVisible" Value="False"/></Style>
        <Style Selector="local|WebView.compact TextBlock.apptitle"><Setter Property="FontSize" Value="16"/></Style>
        <Style Selector="local|WebView.compact TextBlock.setuptitle"><Setter Property="FontSize" Value="22"/></Style>
        <Style Selector="local|WebView.compact TextBlock.winner"><Setter Property="FontSize" Value="20"/></Style>
        <Style Selector="local|WebView.compact Button.quit"><Setter Property="Padding" Value="10,4"/></Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*" ColumnDefinitions="*">
        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource SystemAccentColorDark1Brush}" Padding="12,8" CornerRadius="0">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Classes="apptitle" Text="🎲 SANYALnet Labs Ludo AI Arena" FontSize="20" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                    <TextBlock Classes="subtitle" Text="Four AI Players" FontSize="14" Foreground="White" Opacity="0.8" VerticalAlignment="Center" Margin="16,0,0,0"/>
                    <TextBlock Classes="phase" Text="{Binding PhaseMessage}" FontSize="12" Foreground="White" Opacity="0.7" VerticalAlignment="Center" Margin="12,0,0,0"/>
                </StackPanel>
                <Button x:Name="HeaderQuit" Grid.Column="1" Classes="quit" Content="QUIT" Command="{Binding QuitCommand}"
                        IsVisible="{Binding IsGameRunning}"
                        Background="#cc3333" Foreground="White" FontWeight="Bold"
                        Padding="16,6" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Game area; column/row layout is set per size class in code-behind. -->
        <Grid x:Name="GameGrid" Grid.Row="1" Margin="8">

            <!-- Setup screen -->
            <Border x:Name="SetupBorder" Classes="setup" IsVisible="{Binding IsSetupVisible}"
                    Background="{StaticResource SystemControlBackgroundChromeMediumLowBrush}"
                    CornerRadius="8">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="16" MaxWidth="500" HorizontalAlignment="Center">
                        <TextBlock Classes="setuptitle" Text="SANYALnet Labs Ludo AI Arena" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                        <TextBlock Text="Four AI Players - Automatic Game" FontSize="16" HorizontalAlignment="Center" Foreground="Gray" TextWrapping="Wrap" TextAlignment="Center"/>

                        <TextBlock Text="Player Names" FontSize="18" FontWeight="Bold" Margin="0,16,0,0"/>
                        <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto">
                            <Ellipse Grid.Row="0" Grid.Column="0" Width="20" Height="20" Fill="Red" Margin="0,0,8,0"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding RedName}" Watermark="HAL 9000"/>
                            <TextBlock Classes="hint" Grid.Row="0" Grid.Column="2" Text="Assertive" Foreground="Gray" VerticalAlignment="Center" Margin="8,0,0,0"/>

                            <Ellipse Grid.Row="1" Grid.Column="0" Width="20" Height="20" Fill="Green" Margin="0,0,8,0"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding GreenName}" Watermark="Marvin"/>
                            <TextBlock Classes="hint" Grid.Row="1" Grid.Column="2" Text="Safety-conscious" Foreground="Gray" VerticalAlignment="Center" Margin="8,0,0,0"/>

                            <Ellipse Grid.Row="2" Grid.Column="0" Width="20" Height="20" Fill="#dcc81e" Margin="0,0,8,0"/>
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding YellowName}" Watermark="Mal"/>
                            <TextBlock Classes="hint" Grid.Row="2" Grid.Column="2" Text="Progress-focused" Foreground="Gray" VerticalAlignment="Center" Margin="8,0,0,0"/>

                            <Ellipse Grid.Row="3" Grid.Column="0" Width="20" Height="20" Fill="Blue" Margin="0,0,8,0"/>
                            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding BlueName}" Watermark="Deckard"/>
                            <TextBlock Classes="hint" Grid.Row="3" Grid.Column="2" Text="Balanced" Foreground="Gray" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </Grid>

                        <StackPanel Spacing="4">
                            <TextBlock Text="Rules: Indian Digital Classic" FontWeight="Bold"/>
                            <TextBlock Text="NVIDIA NIM:" FontWeight="Bold"/>
                            <TextBlock Text="{Binding NimStatus}" Foreground="Gray" TextWrapping="Wrap"/>
                        </StackPanel>

                        <Button Content="START GAME" Command="{Binding StartGameCommand}"
                                FontSize="18" FontWeight="Bold" Padding="24,12"
                                Background="{StaticResource SystemAccentColorBrush}" Foreground="White"
                                HorizontalAlignment="Center" Margin="0,16,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Left sidebar: players (hidden on phones). The die + commentary live in DieStatus,
                 which code-behind moves under the board on phones. -->
            <Panel x:Name="LeftHost" Grid.Column="0">
                <Border IsVisible="{Binding IsGameRunning}" Padding="8" MinWidth="170"
                        Background="{StaticResource SystemControlBackgroundChromeLowBrush}" CornerRadius="4">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="LeftStack" Spacing="8">
                            <StackPanel x:Name="PlayersBlock" Spacing="8">
                            <TextBlock Text="Players" FontWeight="Bold" FontSize="16"/>

                            <Border Padding="6" CornerRadius="4"
                                    Background="{Binding IsRedActive, Converter={x:Static local:WebView.BoolToHighlightConverter}}">
                                <StackPanel Spacing="2">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Ellipse Width="14" Height="14" Fill="Red"/>
                                        <TextBlock Text="{Binding RedName}" FontWeight="Bold"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding RedStatus}" FontSize="11" Foreground="Gray"/>
                                </StackPanel>
                            </Border>

                            <Border Padding="6" CornerRadius="4"
                                    Background="{Binding IsGreenActive, Converter={x:Static local:WebView.BoolToHighlightConverter}}">
                                <StackPanel Spacing="2">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Ellipse Width="14" Height="14" Fill="Green"/>
                                        <TextBlock Text="{Binding GreenName}" FontWeight="Bold"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding GreenStatus}" FontSize="11" Foreground="Gray"/>
                                </StackPanel>
                            </Border>

                            <Border Padding="6" CornerRadius="4"
                                    Background="{Binding IsYellowActive, Converter={x:Static local:WebView.BoolToHighlightConverter}}">
                                <StackPanel Spacing="2">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Ellipse Width="14" Height="14" Fill="#dcc81e"/>
                                        <TextBlock Text="{Binding YellowName}" FontWeight="Bold"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding YellowStatus}" FontSize="11" Foreground="Gray"/>
                                </StackPanel>
                            </Border>

                            <Border Padding="6" CornerRadius="4"
                                    Background="{Binding IsBlueActive, Converter={x:Static local:WebView.BoolToHighlightConverter}}">
                                <StackPanel Spacing="2">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Ellipse Width="14" Height="14" Fill="Blue"/>
                                        <TextBlock Text="{Binding BlueName}" FontWeight="Bold"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding BlueStatus}" FontSize="11" Foreground="Gray"/>
                                </StackPanel>
                            </Border>
                            </StackPanel>

                            <!-- Die + commentary. Fixed height and a flashing background (never a
                                 resize), so the board never changes size when the die is emphasized. -->
                            <Grid x:Name="DieStatus" RowDefinitions="Auto,Auto" IsVisible="{Binding IsGameRunning}">
                                <Border x:Name="DieCard" Grid.Row="0" Padding="8" CornerRadius="4" MinHeight="96"
                                        Background="{Binding DieHighlighted, Converter={x:Static local:WebView.DieFlashConverter}}">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Die" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding DieValue}" FontSize="36" FontWeight="Bold"
                                                   HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Border x:Name="StatusCard" Grid.Row="1" Margin="0,8,0,0" Padding="8" CornerRadius="4"
                                        Background="{StaticResource SystemControlBackgroundChromeMediumBrush}">
                                    <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" FontSize="12"
                                               VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Panel>

            <!-- Board -->
            <app:BoardControl x:Name="Board" Grid.Column="1" ViewModel="{Binding}"
                              IsVisible="{Binding IsGameRunning}" Margin="8"/>

            <!-- Right sidebar: event log (Full size only) -->
            <Panel x:Name="RightHost" Grid.Column="2">
                <Border IsVisible="{Binding IsGameRunning}" Padding="8" MinWidth="200"
                        Background="{StaticResource SystemControlBackgroundChromeLowBrush}" CornerRadius="4">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Event Log" FontWeight="Bold" FontSize="14"/>
                        <ScrollViewer MaxHeight="650">
                            <ItemsControl ItemsSource="{Binding EventLog}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontSize="10" Margin="0,1" TextWrapping="Wrap"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>
            </Panel>

            <!-- Phones: die + commentary (moved here by code-behind) and the notice, under the board -->
            <StackPanel x:Name="BottomHost" Grid.Row="1" Grid.ColumnSpan="3" Spacing="4" IsVisible="False">
                <TextBlock x:Name="CopyrightBar" Text="(C) Supratim Sanyal + AI Agents"
                           HorizontalAlignment="Right" FontSize="10" Foreground="#888888"/>
            </StackPanel>

            <!-- Copyright notice, fixed bottom-right on both setup and game screens -->
            <TextBlock x:Name="CopyrightOverlay" Grid.ColumnSpan="3"
                       Text="(C) Supratim Sanyal + AI Agents"
                       HorizontalAlignment="Right" VerticalAlignment="Bottom"
                       Margin="0,0,10,4" FontSize="10" Foreground="#888888" ZIndex="50"/>

            <!-- Game Over Overlay -->
            <Border x:Name="GameOverBorder" Grid.ColumnSpan="3" IsVisible="{Binding IsGameOver}"
                    Background="#cc000000" ZIndex="100">
                <StackPanel Spacing="16" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12">
                    <TextBlock Text="🏆" FontSize="64" HorizontalAlignment="Center"/>
                    <TextBlock Classes="winner" Text="{Binding WinnerMessage}" FontSize="28" FontWeight="Bold"
                               Foreground="White" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" Spacing="16" HorizontalAlignment="Center">
                        <Button Content="NEW GAME" Command="{Binding NewGameCommand}"
                                FontSize="16" Padding="20,10"
                                Background="{StaticResource SystemAccentColorBrush}" Foreground="White"/>
                        <Button Content="QUIT" Command="{Binding QuitCommand}"
                                FontSize="16" Padding="20,10"
                                Background="#cc3333" Foreground="White"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
