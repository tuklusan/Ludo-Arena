<!-- WebAssembly (browser) head for Ludo Arena.

     Deliberately NOT part of LudoNimArena.slnx: building it needs the .NET `wasm-tools`
     workload (which ships Emscripten), and every desktop CI job builds the solution.
     The release workflow builds this project explicitly:
       dotnet workload install wasm-tools
       dotnet publish src/LudoNimArena.Browser -c Release

     It runs the same game (view model, board control, Core, AI) as the desktop app, inside a
     web-only responsive shell. -->
<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
  <PropertyGroup>
    <TargetFramework>net10.0-browser</TargetFramework>
    <RootNamespace>LudoNimArena.Browser</RootNamespace>
    <AssemblyName>LudoNimArena.Browser</AssemblyName>
    <OutputType>Exe</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <WasmMainJSPath>wwwroot\main.js</WasmMainJSPath>
    <WasmRuntimeAssetsLocation>./_framework</WasmRuntimeAssetsLocation>
    <!-- Relink the .NET runtime with Emscripten (emcc) for a smaller, faster dotnet.native.wasm. -->
    <WasmBuildNative>true</WasmBuildNative>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- ILLink/Emscripten emit trim and AOT warnings for Avalonia internals that are not ours to fix. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- Set -p:RunAOTCompilation=true to ahead-of-time compile to WebAssembly (slower build, faster game). -->
    <TrimMode>partial</TrimMode>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\LudoNimArena.Core\LudoNimArena.Core.csproj" />
    <ProjectReference Include="..\LudoNimArena.AI\LudoNimArena.AI.csproj" />
  </ItemGroup>

  <!-- Shared game sources from the desktop project: the view model and board control only.
       The desktop shell (Program, App, MainWindow, MainView) is NOT compiled into the web build;
       the web has its own responsive shell (WebApp, WebView), so desktop code is never touched. -->
  <ItemGroup>
    <Compile Include="..\LudoNimArena.App\*.cs"
             Exclude="..\LudoNimArena.App\Program.cs;..\LudoNimArena.App\App.axaml.cs;..\LudoNimArena.App\MainWindow.axaml.cs;..\LudoNimArena.App\MainView.axaml.cs"
             LinkBase="Shared" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Browser" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Avalonia.ReactiveUI" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>
</Project>
